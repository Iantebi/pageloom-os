rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // request.auth.token.get(key, default) is used instead of direct property access because the
    // vast majority of tokens never carry a platformRole claim at all (only actual platform
    // owners/admins do), and `in` on a genuinely-absent map key throws "Property platformRole is
    // undefined on object" rather than evaluating false - confirmed via the behavioral rules
    // test suite against the real emulator rules engine, where that error was propagating through
    // every `||` starting with platformAdmin() (staff(), privileged()) and denying reads that
    // should have fallen through to the rest of the check.
    function platformAdmin() { return signedIn() && request.auth.token.get('platformRole', null) in ['owner','admin']; }
    function member(orgId) { return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.disabled != true; }
    function role(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role; }
    function staff(orgId) { return platformAdmin() || (member(orgId) && role(orgId) in ['owner','admin','operator','member']); }
    // Financial, infrastructure and security-sensitive collections: owner/admin/operator only.
    // 'member' is intentionally excluded (least privilege) even though it is a staff role.
    function privileged(orgId) { return platformAdmin() || (member(orgId) && role(orgId) in ['owner','admin','operator']); }
    function client(orgId) { return member(orgId) && role(orgId) == 'client'; }
    function clientCustomerId(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.customerId; }
    function clientProject(orgId, projectId) { return client(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.customerId == clientCustomerId(orgId) && (!('projectIds' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data) || get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.projectIds.size() == 0 || projectId in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.projectIds); }
    // List-query-safe equivalent of clientProject, used only at the top-level projects/{projectId}
    // match below. Firestore cannot prove a list/query rule safe for every possible result when it
    // depends on an explicit get() of the very document being evaluated (clientProject's redundant
    // get(.../projects/$(projectId)) instead of the already-available `resource`) — it rejects the
    // whole query outright with PERMISSION_DENIED regardless of what real data would return. Using
    // resource.data/resource.id directly (identical semantics, same customerId + projectIds checks,
    // same single fixed get() on the requester's own membership doc) is the form Firestore can prove
    // safe for a list/query. clientProject(orgId, projectId) is kept as-is for sub-collection matches
    // below (comments/questionnaires/documents), where the parent projectId is fixed by the path and
    // this limitation does not apply.
    // resource.data.get('customerId', null) (not bare .customerId) for the same reason as
    // platformAdmin() above: the behavioral test suite showed the emulator's list/query safety
    // analysis evaluates this condition against a resource that doesn't reliably carry the field,
    // and bare property access throws "Property customerId is undefined on object" there instead
    // of evaluating false - .get() with a default makes the equality check simply false instead.
    function clientProjectList(orgId) { return client(orgId) && resource.data.get('customerId', null) == clientCustomerId(orgId) && (!('projectIds' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data) || get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.projectIds.size() == 0 || resource.id in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.projectIds); }
    match /organizations/{orgId} {
      allow read: if staff(orgId); allow write: if false;
      match /members/{uid} { allow read: if staff(orgId); allow write: if false; }

      // Privileged-only: financial ledgers, infrastructure, and security/admin records.
      match /revenue/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /expenses/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /agentSettings/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /infrastructurePlans/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /backupRuns/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /domains/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /certificates/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /fleetResources/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /incidents/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /alerts/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /securityEvents/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /deadLetters/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /executions/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /apiKeys/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /secrets/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /auditLogs/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /scheduledJobs/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /maintenanceRequests/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /reviews/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /pricingPackages/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /legalDocuments/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /projects/{projectId}/legalAcceptances/{acceptanceId} { allow read: if privileged(orgId); allow write: if false; }
      match /customers/{customerId}/closing/{docId} { allow read: if privileged(orgId); allow write: if false; }

      // Staff-broad operational collections (any of owner/admin/operator/member).
      // Firestore ORs every matching rule for a path, so each collection that must
      // stay privileged-only above is intentionally NOT covered by a wildcard here —
      // a wildcard would re-grant 'member' access and silently undo the restriction.
      match /leads/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /customers/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /tasks/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /approvals/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /usage/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /metrics/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /communicationDrafts/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /deployments/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /builds/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /activity/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /journeyEvents/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /workflowInstances/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /workflowEvents/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /workflowHistory/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /workflowLogs/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /notifications/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /calendarEvents/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /customerInvitations/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /staffInvitations/{docId} { allow read: if privileged(orgId); allow write: if false; }
      match /documentTemplates/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /reports/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /websites/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /websites/{websiteId}/content/{contentId} { allow read: if staff(orgId) || (client(orgId) && resource.data.customerId == clientCustomerId(orgId)); allow write: if false; }
      match /websites/{websiteId}/contentSubmissions/{submissionId} { allow read: if privileged(orgId); allow write: if false; }
      match /websites/{websiteId}/contentRevisions/{revisionId} { allow read: if privileged(orgId); allow write: if false; }
      match /websiteVersions/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /templates/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /leads/{leadId}/notes/{noteId} { allow read: if staff(orgId); allow write: if false; }
      match /customers/{customerId}/contacts/{contactId} { allow read: if staff(orgId); allow write: if false; }
      match /customers/{customerId}/documents/{documentId} { allow read: if staff(orgId); allow write: if false; }
      match /chats/{chatId}/messages/{messageId} { allow read: if staff(orgId); allow write: if false; }
      match /projects/{projectId}/artifacts/{artifactId} { allow read: if staff(orgId); allow write: if false; }
      match /projects/{projectId} { allow read: if staff(orgId) || clientProjectList(orgId); allow write: if false; }
      match /projects/{projectId}/comments/{commentId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }
      match /projects/{projectId}/questionnaires/{questionnaireId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }
      match /projects/{projectId}/documents/{documentId} { allow read: if staff(orgId) || (clientProject(orgId, projectId) && resource.data.audience == 'customer'); allow write: if false; }
      match /projects/{projectId}/documents/{documentId}/signatures/{signatureId} { allow read: if staff(orgId); allow write: if false; }
      match /supportTickets/{ticketId} { allow read: if staff(orgId) || (client(orgId) && resource.data.customerId == clientCustomerId(orgId)); allow write: if false; }
      match /supportTickets/{ticketId}/internalNotes/{noteId} { allow read: if staff(orgId); allow write: if false; }
      match /projects/{projectId}/revisionRequests/{requestId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }
      match /projects/{projectId}/launchChecklist/{docId} { allow read: if staff(orgId); allow write: if false; }
      match /projects/{projectId}/handover/{docId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }

      // Business Discovery ("אפיון העסק") — see docs/customer-discovery-onboarding/SECURITY.md §3.
      // discovery/{sectionId} and discoveryProgress/{docId} mirror the questionnaires/revisionRequests/
      // handover pattern above exactly: staff or the project's assigned client can read, no client write
      // path exists anywhere (server/Admin SDK only). discoveryNotes is deliberately staff-only with NO
      // clientProject() clause — this is the enforcement point for "customer must never see internal
      // notes" and must never gain one. businessProfile is staff-only at launch (unpopulated in this
      // release; its eventual content is internal AI analysis, not customer-facing by default).
      match /projects/{projectId}/discovery/{sectionId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }
      match /projects/{projectId}/discoveryProgress/{docId} { allow read: if staff(orgId) || clientProject(orgId, projectId); allow write: if false; }
      match /projects/{projectId}/discoveryNotes/{noteId} { allow read: if staff(orgId); allow write: if false; }
      match /projects/{projectId}/businessProfile/{docId} { allow read: if staff(orgId); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
