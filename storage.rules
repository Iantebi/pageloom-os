rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // See the matching comment in firestore.rules: .get(key, default) avoids throwing on tokens
    // that never carry a platformRole claim at all (i.e. every non-platform-admin user).
    function platformAdmin() { return request.auth != null && request.auth.token.get('platformRole', null) in ['owner','admin']; }
    function member(orgId) { return request.auth != null && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.disabled != true; }
    function membership(orgId) { return firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data; }
    function staff(orgId) { return platformAdmin() || (member(orgId) && membership(orgId).role in ['owner','admin','operator','member']); }
    function clientProject(orgId, projectId) { return member(orgId) && membership(orgId).role == 'client' && firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)).data.customerId == membership(orgId).customerId && (!('projectIds' in membership(orgId)) || membership(orgId).projectIds.size() == 0 || projectId in membership(orgId).projectIds); }
    function clientCustomer(orgId, customerId) { return member(orgId) && membership(orgId).role == 'client' && membership(orgId).customerId == customerId; }
    function clientPermission(orgId, key) { return !('permissions' in membership(orgId)) || !(key in membership(orgId).permissions) || membership(orgId).permissions[key] == true; }
    function safeUpload(orgId, userId) { return member(orgId) && request.auth.uid == userId && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|application/pdf|text/.*|application/zip|application/vnd.*)'); }
    function safeWebsiteMedia(orgId, userId, fileName) { return member(orgId) && request.auth.uid == userId && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('(image/jpeg|image/png|image/webp|image/gif|video/mp4|video/webm)') && fileName.matches('.*\\.(jpg|jpeg|png|webp|gif|mp4|webm)'); }
    match /organizations/{orgId}/artifacts/{allPaths=**} { allow read: if staff(orgId); allow write: if false; }
    match /organizations/{orgId}/internal-artifacts/{allPaths=**} { allow read: if staff(orgId); allow write: if false; }
    match /organizations/{orgId}/projects/{projectId}/artifacts/{allPaths=**} { allow read: if staff(orgId) || clientProject(orgId,projectId); allow write: if false; }
    match /organizations/{orgId}/uploads/{userId}/{projectId}/{allPaths=**} { allow read: if staff(orgId) || clientProject(orgId,projectId); allow write: if safeUpload(orgId,userId) && (staff(orgId) || (clientProject(orgId,projectId) && clientPermission(orgId,'assets'))); }
    match /organizations/{orgId}/customers/{customerId}/{userId}/{allPaths=**} { allow read: if staff(orgId) || clientCustomer(orgId,customerId); allow write: if safeUpload(orgId,userId) && (staff(orgId) || clientCustomer(orgId,customerId)); }
    match /organizations/{orgId}/questionnaires/{projectId}/{questionnaireId}/{fieldId}/{userId}/{allPaths=**} { allow read: if staff(orgId) || clientProject(orgId,projectId); allow write: if safeUpload(orgId,userId) && (staff(orgId) || clientProject(orgId,projectId)); }
    match /organizations/{orgId}/website-media/{customerId}/{projectId}/{websiteId}/{userId}/{fileName} {
      allow read: if staff(orgId) || (clientCustomer(orgId,customerId) && clientProject(orgId,projectId));
      allow create, update: if safeWebsiteMedia(orgId,userId,fileName) && (staff(orgId) || (clientCustomer(orgId,customerId) && clientProject(orgId,projectId) && clientPermission(orgId,'contentEdit')));
      allow delete: if member(orgId) && request.auth.uid == userId && (staff(orgId) || (clientCustomer(orgId,customerId) && clientProject(orgId,projectId)));
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
