# Browser-safe Firebase configuration (apps/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, App Check readiness (see docs/SECURITY.md): leave both unset to keep current behavior
# unchanged. Setting the site key requires first registering a reCAPTCHA v3 key for this app in the
# Firebase console - that console step is not part of this repo and is not done by setting this var.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local/emulator development only. Never set this in a deployed environment.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Cloud Functions secrets: configure with `firebase functions:secrets:set NAME`
AI_EXECUTION_MODE=manual
# Production only: AI_EXECUTION_MODE=api has no effect in the deployed production project unless
# this also exactly equals API_MODE_APPROVED_FOR_PRODUCTION. Leave unset/blank to stay on the
# free manual queue. Never set this outside a deliberate, reviewed change to enable live billing.
AI_EXECUTION_MODE_APPROVAL=
AI_API_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_FALLBACK_ENABLED=false
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_SUBJECT=
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRM_BASE_URL=
CRM_API_TOKEN=
ZAPIER_WEBHOOK_SECRET=
MAKE_WEBHOOK_SECRET=
N8N_BASE_URL=
N8N_API_KEY=
GITHUB_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GCP_DEPLOY_PROJECT_ID=

# Optional Cloud Functions params (have code defaults in functions/src/config.ts; override only if needed)
PAGELOOM_FUNCTION_REGION=
PAGELOOM_BACKUP_BUCKET=
PAGELOOM_BACKUP_SERVICE_ACCOUNT=
AGENCY_TIMEZONE=
