# Browser-safe Firebase configuration (apps/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Functions secrets: configure with `firebase functions:secrets:set NAME`
AI_EXECUTION_MODE=manual
AI_API_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_FALLBACK_ENABLED=false
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_SUBJECT=
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRM_BASE_URL=
CRM_API_TOKEN=
ZAPIER_WEBHOOK_SECRET=
MAKE_WEBHOOK_SECRET=
N8N_BASE_URL=
N8N_API_KEY=
GITHUB_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GCP_DEPLOY_PROJECT_ID=

# Optional Cloud Functions params (have code defaults in functions/src/config.ts; override only if needed)
PAGELOOM_FUNCTION_REGION=
PAGELOOM_BACKUP_BUCKET=
PAGELOOM_BACKUP_SERVICE_ACCOUNT=
AGENCY_TIMEZONE=
